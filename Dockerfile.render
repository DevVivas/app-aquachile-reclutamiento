# syntax=docker/dockerfile:1
# Imagen única para Render: la API Express sirve también la SPA compilada.

# ---- Frontend ----
FROM node:22-alpine AS web-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ---- Dependencias de la API ----
FROM node:22-alpine AS api-dependencies
WORKDIR /app
COPY server/package*.json ./
RUN npm ci --omit=dev

# ---- Runtime ----
FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV STATIC_DIR=/app/public
WORKDIR /app
COPY --from=api-dependencies --chown=node:node /app/package*.json ./
COPY --from=api-dependencies --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node server/src ./src
COPY --from=web-build --chown=node:node /app/dist ./public

USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/api/health').then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "src/index.js"]
