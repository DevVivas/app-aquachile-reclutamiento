server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # CVs (PDF/Word) se suben por /api: el límite por defecto (1 MB) es muy bajo
    client_max_body_size 20m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Cabeceras de seguridad (no se usa add_header en los location para no perderlas)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Healthcheck para Docker / balanceador
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # API: se redirige al backend definido en BACKEND_URL
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Assets con hash de Vite: cacheables un año
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # index.html nunca se cachea (así los despliegues nuevos se ven al tiro)
    location = /index.html {
        expires -1;
    }

    # Fallback de la SPA (/admin, /admin/solicitudes/:id, etc.)
    location / {
        try_files $uri /index.html;
    }
}
