# Proxy API para desarrollo local de Vite
VITE_API_PROXY_TARGET=http://localhost:3000

# Backend Supabase. Completar en .env (no compartir ni subir la clave real).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
CV_BUCKET=cvs

# Puerto HTTP local del frontend Docker Compose
WEB_PORT=8080
