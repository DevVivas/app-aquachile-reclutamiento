# Proxy API para desarrollo local de Vite
VITE_API_PROXY_TARGET=http://localhost:3000

# Backend Supabase. Completar en .env (no compartir ni subir las claves reales).
SUPABASE_URL=https://your-project.supabase.co
# Clave secreta/service_role: solo servidor, omite RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Clave pública (anon/publishable): se usa solo para iniciar sesión en Supabase Auth.
SUPABASE_ANON_KEY=
PORT=3000
CV_BUCKET=cvs
TEMPLATES_BUCKET=plantillas

# Opcionales
# Saltos de proxy confiables para calcular la IP del cliente (rate limiting). Por defecto 1.
# TRUST_PROXY=1
# Cookies Secure: true por defecto en producción; false solo para http local sin proxy TLS.
# COOKIE_SECURE=false

# Puerto HTTP local del frontend Docker Compose
WEB_PORT=8080
